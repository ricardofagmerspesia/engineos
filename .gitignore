# The opt-in embedding daemon is its own package with its own install, never a
# workspace of the root one (docs/OPT-IN-TIERS.md); named so the root rule above
# is not the only thing keeping onnxruntime-node out of the tree.
tools/embedding-daemon/node_modules/
build/
dist-release/

# Worktrees criadas por agentes e overrides locais do operador: estado de
# maquina, nunca do repositorio (o PRD exige que settings.local.json nunca
# seja sobrescrito).
.claude/worktrees/
.claude/settings.local.json

# Router golden-set candidates: real prompts from session transcripts, may
