{
  // Node-runnable build of the pure library modules, for `node --test`.
  //
  // The app's own tsconfig is Next's: noEmit, bundler resolution, JSX preserved.
  // None of that can be executed by node directly, so the tests get their own
  // emitting config instead of the suite pulling in a bundler or a test
  // framework. Same shape as the root package's `tsc && node --test build`.
  //
  // Mostly `src/lib/**`: those modules are pure and base-path injected by
  // design (rules/architecture.md), so they run under node with no Next
  // runtime. `src/middleware.ts` is the one exception — it imports
  // `next/server`, which loads and runs under plain node, so the gate in front
  // of every /api/** route gets a test instead of no test. Route handlers are
  // still not tested here: they are orchestration over these modules, and
  // testing them would mean booting Next.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".test-build",
    "rootDir": "src",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "incremental": false,
    "plugins": [],
    "types": ["node"]
  },
  // Only the modules under test and their own imports. store/ is excluded on
  // purpose: it is the better-sqlite3 seam and uses import.meta, neither of
  // which belongs in a node --test build of pure logic.
  "include": [
    "src/lib/contained-path.ts",
    "src/lib/contained-path.test.ts",
    "src/lib/entities/**/*.ts",
    "src/lib/kernel.ts",
    "src/lib/kernel-args.test.ts",
    "src/lib/publish-lock.ts",
    "src/lib/publish-lock.test.ts",
    "src/lib/request-origin.ts",
    "src/lib/request-origin.test.ts",
    "src/lib/validate/**/*.ts",
    "src/middleware.ts",
    "src/middleware.test.ts"
  ],
  "exclude": ["node_modules", ".next", ".test-build"]
}
