{
  "name": "engineos-admin-console",
  "version": "0.1.0",
  "private": true,
  "description": "Local admin console for the EngineOS plugin's capability graph (skills, agents, models, MCP, routing, rules).",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && cd .test-build && node --test",
    "decisions:build": "node scripts/build-decisions-worker.mjs",
    "decisions:worker": "node .decision-build/worker.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
