  "cards": [
    {
      "dot": "cyan",
      "title": "Control loop",
      "items": [
        "Every prompt, edit, agent dispatch and stop passes through a hook",
        "Hooks ask kernel.sh; the kernel answers only from registries, never from prose",
        "Stop gates: scoped lint/typecheck and an unrecorded-change check"
      ]
    },
    {
      "dot": "violet",
      "title": "Two mirrors kept honest",
      "items": [
        "CLAUDE.md router table is the human mirror of registries/routing.json",
        "validate-engineos.sh fails CI when the mirrors disagree",
        "22 agents declare their tier; registries/agents.json is generated from them"
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime migration",
      "items": [
        "Wave 0 shipped the toolchain, Io seam and node guard as dist/engineos.cjs",
        "Waves 1-6 shim hooks, kernel and checks onto the bundle",
        "Bundle must rebuild byte-identical; CI enforces it"
      ]
    }
  ]
