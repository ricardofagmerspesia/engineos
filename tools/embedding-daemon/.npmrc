# No dependency lifecycle script runs at install: a large third-party tree
# gets no install-time code execution, and the CPU binaries this daemon uses
# ship inside the npm packages. `npm start` still runs (explicit scripts are unaffected).
ignore-scripts=true
# onnxruntime-node's postinstall fetches the CUDA execution provider from NuGet
# on linux/x64; the CPU binaries this daemon uses ship inside the npm package.
onnxruntime-node-install=skip
save-exact=true
engine-strict=true
fund=false
